# Cloudflare Pages security headers
/*
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(self), camera=(), microphone=()
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' *.cartocdn.com; style-src 'self' 'unsafe-inline' *.cartocdn.com; img-src 'self' data: https: blob:; font-src 'self'; connect-src 'self' http://localhost:3000 https:; frame-ancestors 'none';
